{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sfia.local/schemas/d2-d1/source-disclosure.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "providerLane",
    "limits",
    "processLocalMemory",
    "cursorUnverified"
  ],
  "properties": {
    "source": {
      "type": "string",
      "enum": ["fixture", "sandbox-real", "real"]
    },
    "providerLane": {
      "type": "string",
      "enum": ["ai", "git", "cursor", "none"]
    },
    "limits": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "processLocalMemory": {
      "type": "boolean",
      "const": true
    },
    "cursorUnverified": {
      "type": "boolean"
    }
  }
}
